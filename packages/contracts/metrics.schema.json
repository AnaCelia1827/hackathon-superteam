{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looprail.local/contracts/v1/metrics.schema.json",
  "title": "LoopRail Metrics v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "session_id", "mode", "steps", "duration_ms", "provider_latency_p50_ms", "provider_latency_p95_ms", "looprail_overhead_p50_ms", "looprail_overhead_p95_ms", "usdc_authorized_base_units", "usdc_reserved_base_units", "usdc_spent_base_units", "usdc_refunded_base_units", "onchain_transactions", "settlements", "source"],
  "properties": {
    "version": { "const": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["mock", "replay", "live"] },
    "steps": { "type": "integer", "minimum": 0 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "provider_latency_p50_ms": { "type": "integer", "minimum": 0 },
    "provider_latency_p95_ms": { "type": "integer", "minimum": 0 },
    "looprail_overhead_p50_ms": { "type": "integer", "minimum": 0 },
    "looprail_overhead_p95_ms": { "type": "integer", "minimum": 0 },
    "usdc_authorized_base_units": { "type": "integer", "minimum": 0 },
    "usdc_reserved_base_units": { "type": "integer", "minimum": 0 },
    "usdc_spent_base_units": { "type": "integer", "minimum": 0 },
    "usdc_refunded_base_units": { "type": "integer", "minimum": 0 },
    "onchain_transactions": { "type": "integer", "minimum": 0 },
    "settlements": { "type": "integer", "minimum": 0 },
    "source": { "enum": ["simulation", "ledger_and_receipts"] }
  }
}
